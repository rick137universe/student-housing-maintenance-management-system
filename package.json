{
  "name": "student-housing-maintenance-management-system",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "学生公寓住宿与报修管理系统",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rick137universe/student-housing-maintenance-management-system.git"
  },
  "homepage": "https://github.com/rick137universe/student-housing-maintenance-management-system",
  "bugs": {
    "url": "https://github.com/rick137universe/student-housing-maintenance-management-system/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "node scripts/runtime/start.mjs",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:seed": "tsx scripts/database/seed.ts",
    "jobs": "tsx scripts/runtime/jobs.ts",
    "jobs:once": "tsx scripts/runtime/jobs.ts --once",
    "restore:check": "tsx scripts/database/restore-check.ts",
    "test:integration": "tsx tests/runners/integration.ts",
    "test:e2e": "tsx tests/runners/integration.ts --browser",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
